# Copy to .env.test to run the suite. Values match docker-compose.yml.
# Contains no secrets — the test database is disposable and local-only.
NODE_ENV=test
PORT=3001

# Must end in _test: tests/setup.ts refuses to run against any other database.
# Created automatically on first container start by docker/init-test-db.sql.
DATABASE_URL=postgres://ebs:ebs@localhost:5433/ebs_test

# Database 1, so a test flush never touches the development cache.
REDIS_URL=redis://localhost:6380/1

# Seconds, not minutes: expiry and lazy-reclaim tests need locks that
# actually expire within the lifetime of a test run.
CHECKOUT_LOCK_TTL_SECONDS=2

JWT_SECRET=test-secret
JWT_EXPIRES_IN_SECONDS=3600
