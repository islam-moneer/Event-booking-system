# Copy to .env for local development. Values below match docker-compose.yml.
NODE_ENV=development
PORT=3000

# Host port 5433, not 5432 — see docker-compose.yml
DATABASE_URL=postgres://ebs:ebs@localhost:5433/ebs_dev

# Phase 5 (cache). Host port 6380, not 6379.
REDIS_URL=redis://localhost:6380

# How long a checkout holds its seats before the lock is considered expired.
# 5 minutes in development; .env.test overrides this to seconds so expiry
# tests don't have to wait.
CHECKOUT_LOCK_TTL_SECONDS=300

# JWT signing secret; must be replaced in production
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN_SECONDS=3600
